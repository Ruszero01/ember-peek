# Copy to .env for local publishing. Never commit real credentials.
OSS_REGION=oss-cn-hongkong
OSS_BUCKET=your-distribution-bucket
OSS_PREFIX=ember-peek
OSS_PUBLIC_BASE_URL=https://your-distribution-bucket.oss-cn-hongkong.aliyuncs.com/ember-peek
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, when using STS temporary credentials.
OSS_STS_TOKEN=
