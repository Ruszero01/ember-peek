{
  "api": 1,
  "minHostVersion": "0.1.1",
  "category": "media",
  "id": "ember.audio",
  "name": "音频预览",
  "version": "0.1.0",
  "extensions": [
    "mp3",
    "mp2",
    "mp1",
    "mpa",
    "wav",
    "wave",
    "flac",
    "ogg",
    "oga",
    "opus",
    "aac",
    "adts",
    "m4a",
    "m4b",
    "m4r",
    "aif",
    "aiff",
    "aifc",
    "caf",
    "mka",
    "weba"
  ],
  "icon": "music",
  "executable": "bin/ember-audio-plugin.exe",
  "entry": "ui/index.html",
  "capabilities": [
    "view",
    "controls"
  ],
  "permissions": [
    "readFile"
  ],
  "activation": {
    "mode": "auto",
    "priority": 110
  },
  "settings": [
    {
      "key": "autoplay",
      "type": "bool",
      "label": "自动播放",
      "help": "音频准备好后自动播放；隐藏或切换预览会暂停。",
      "default": true
    },
    {
      "key": "loop",
      "type": "bool",
      "label": "循环播放",
      "default": false
    },
    {
      "key": "volume",
      "type": "number",
      "label": "音量",
      "hidden": true,
      "default": 0.8,
      "min": 0.01,
      "max": 1
    }
  ],
  "i18n": {
    "en": {
      "name": "Audio Preview",
      "settings": {
        "autoplay": {
          "label": "Autoplay",
          "help": "Start when ready; hiding or switching previews pauses playback."
        },
        "loop": {
          "label": "Loop playback"
        },
        "volume": {
          "label": "Volume"
        }
      }
    }
  }
}
