{
  "api": 1,
  "id": "ember.code",
  "name": "代码预览",
  "version": "0.1.0",
  "extensions": [
    "js",
    "mjs",
    "cjs",
    "ts",
    "tsx",
    "jsx",
    "json",
    "jsonc",
    "rs",
    "py",
    "pyw",
    "html",
    "htm",
    "css",
    "scss",
    "sass",
    "less",
    "toml",
    "yaml",
    "yml",
    "xml",
    "svg",
    "cs",
    "cpp",
    "cc",
    "cxx",
    "c",
    "h",
    "hpp",
    "java",
    "kt",
    "kts",
    "go",
    "rb",
    "php",
    "swift",
    "lua",
    "sh",
    "bash",
    "zsh",
    "ps1",
    "psm1",
    "bat",
    "cmd",
    "sql",
    "ini",
    "conf",
    "cfg",
    "properties",
    "env",
    "vue",
    "svelte",
    "r",
    "dart",
    "ex",
    "exs",
    "erl",
    "hs",
    "clj",
    "lisp",
    "cmake",
    "gradle",
    "dockerfile",
    "makefile"
  ],
  "icon": "file-code",
  "settings": [
    {
      "key": "lineNumbers",
      "type": "bool",
      "label": "显示行号",
      "help": "在正文左侧显示行号。与文本编辑同一套标准。",
      "default": true
    },
    {
      "key": "wrap",
      "type": "bool",
      "label": "自动换行",
      "help": "关闭后长行横向滚动，不折断。",
      "default": true
    },
    {
      "key": "tabSize",
      "type": "number",
      "label": "制表符宽度",
      "help": "一个制表符显示为多少个空格。",
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1
    }
  ],
  "executable": "bin/ember-code-plugin.exe",
  "entry": "ui/index.html",
  "capabilities": [
    "view",
    "controls"
  ],
  "permissions": [
    "readFile",
    "clipboard"
  ],
  "provides": "ember.text/1",
  "activation": {
    "mode": "auto",
    "priority": 100
  },
  "fileNames": [
    "Dockerfile",
    "Containerfile",
    "Makefile",
    "CMakeLists.txt",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".env",
    ".bashrc",
    ".zshrc"
  ]
}
